# Supabase project credentials used by src/services/supabase.js
# Copy this file to .env and fill in the values for your project.
#
# Only the anon / publishable key belongs here — never a service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
